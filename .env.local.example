# 複製成 .env.local 並填入實際值。
#
# .env.local 不進版控，也不要放到 gist、雲端硬碟、聊天軟體上 ——
# 這類地方會被自動掃描，金鑰會在幾分鐘內被服務商偵測並撤銷。
# 換機器時請用隨身碟或你自己的加密管道傳。
#
# 各項去哪拿：
#   SPOTIFY_CLIENT_ID   https://developer.spotify.com/dashboard
#   SUPABASE_*          Supabase 專案 → Settings → API Keys
#   DEEPGRAM_API_KEY    https://console.deepgram.com
#   GEMINI_API_KEYS     https://aistudio.google.com/apikey
#   GROQ_API_KEYS       https://console.groq.com/keys

# App 端（會被注入 BuildSecrets.swift）
SPOTIFY_CLIENT_ID=
SUPABASE_URL=https://ouwvxdzuvwfzpdozbaby.supabase.co
SUPABASE_ANON_KEY=

# 後端轉錄用（只有要在本機跑 backend/ 才需要）
SUPABASE_SERVICE_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEYS='["key1","key2"]'
GROQ_API_KEYS='["key1","key2"]'
